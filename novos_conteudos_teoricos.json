          "k₀": "0.1",
          "k₁": "0.3",
          "k₂": "0.5"
        }
      },
      {
        "nome": "Derivada Caputo via SOE",
        "formula": "D^α f(t) ≈ Σ w_k λ_k q_k(t)",
        "recursao": "q_k^{n+1} = exp(-λ_k Δt) q_k^n + [1 - exp(-λ_k Δt)] f^n",
        "complexidade": "O(N_exp) por passo (vs. O(N²) direto)"
      },
      {
        "nome": "Acoplamentos Trilineares",
        "formula": "ċ_i = ω_i c_i + Σ_{j,k} K_{ij} c_j c̄_k + Σ_{j,k,l} T_{ijkl} c_j c_k c̄_l",
        "descricao": "Fusão criativa de modos conceituais"
      },
      {
        "nome": "Entropia Condicional Narrativa",
        "formula": "H_N = -Σ p(N) log p(θ|N)",
