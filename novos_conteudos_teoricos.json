          "Re_S > 200": "Turbulento (ruído cognitivo)"
        }
      },
      {
        "nome": "Modulação Topológica via Betti",
        "formula": "β(t) = β₀ × (1 + k₀×β₀(t) + k₁×β₁(t) + k₂×β₂(t))",
        "betti_numbers": {
          "β₀": "Componentes conectadas (pensamentos distintos)",
