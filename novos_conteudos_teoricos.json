          "ν_S": "Viscosidade semântica adaptativa"
        },
        "regimes": {
          "Re_S < 50": "Hiper-laminar (coerência extrema)",
          "50 ≤ Re_S ≤ 100": "Laminar (fluxo cognitivo estável)",
